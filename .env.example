# Copy to .env and fill in. Never commit .env.

# Vendor C usage API. The mock's test key is in docs/vendor_c_api.md.
VENDOR_C_BASE_URL=http://localhost:4010
VENDOR_C_API_KEY=

# Where budget alerts are posted. Accepts:
#   Slack incoming webhook    https://hooks.slack.com/services/...
#   Discord webhook           https://discord.com/api/webhooks/...
#   any other JSON endpoint   e.g. the local mock, http://localhost:4020/webhook (npm run mock:webhook)
# The format is picked from the URL. A Slack or Discord URL saved on the app's
# Budget alert page takes precedence over this one.
# Leave empty to only record alerts in the app and print them in the CLI.
ALERT_WEBHOOK_URL=

# Comma-separated budget thresholds (percent) that trigger an alert.
ALERT_THRESHOLDS=80,100

# SQLite file. Created on first import.
DATABASE_PATH=./data/cost_tracker.db
