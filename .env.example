# Copy to .env and fill in. Never commit .env.

# Vendor C usage API
VENDOR_C_BASE_URL=http://localhost:4010
VENDOR_C_API_KEY=

# Where budget alerts are posted. Discord/Slack-style JSON webhook.
# Leave empty to log alerts to the console instead of sending them.
ALERT_WEBHOOK_URL=

# Comma-separated budget thresholds (percent) that trigger an alert.
ALERT_THRESHOLDS=80,100

# SQLite file. Created on first import.
DATABASE_PATH=./data/cost_tracker.db

# Dashboard port
PORT=3000
